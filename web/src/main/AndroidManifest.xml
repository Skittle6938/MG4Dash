<?xml version="1.0" encoding="utf-8"?>
<!-- Own uid on purpose (no sharedUserId): Android refuses WebView to the system uid -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Cleartext allowed: Home Assistant is often reached at http://homeassistant.local:8123 -->
    <application
        android:allowBackup="false"
        android:label="MG4Dash Web"
        android:usesCleartextTraffic="true">

        <!-- No launcher icon: only started by MG4Dash, in the map widget's virtual display -->
        <activity
            android:name=".WebActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:allowEmbedded="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|locale|layoutDirection|fontScale"
            android:theme="@android:style/Theme.Material.NoActionBar" />
    </application>
</manifest>
