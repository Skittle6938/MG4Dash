<?xml version="1.0" encoding="utf-8"?>
<!-- System uid, like MG4Dash: only this uid can re-enable SAIC home and recompile MG4Dash -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.SET_PREFERRED_APPLICATIONS" />
    <uses-permission android:name="android.permission.CHANGE_COMPONENT_ENABLED_STATE" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.READ_LOGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="false"
        android:vmSafeMode="true"
        android:label="MG4Dash Rescue">
        <!-- vmSafeMode: compiled without a usage profile ("quicken"), so the rescue itself never gets the
             speed-profile code that sometimes does not load (to check on the car: dumpsys package dexopt) -->

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Sent by MG4Dash right after installation: takes the app out of the "stopped" state -->
                <action android:name="app.mg4dash.rescue.INIT" />
                <action android:name="app.mg4dash.rescue.CHECK" />
                <!-- Sent by MG4Dash's updater after its own update: clean recompilation, relaunch, watch -->
                <action android:name="app.mg4dash.rescue.UPDATED" />
                <!-- Sent by MG4Dash when its code does not load -->
                <action android:name="app.mg4dash.rescue.CRASH" />
            </intent-filter>
            <!-- Android's crash log (READ_LOGS): a crash of MG4Dash's code that does not load -->
            <intent-filter>
                <action android:name="android.intent.action.DROPBOX_ENTRY_ADDED" />
            </intent-filter>
            <!-- MG4Dash installed by another way (USB, ADB): to check on the car that it is delivered -->
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <data android:scheme="package" android:ssp="app.mg4dash" />
            </intent-filter>
        </receiver>

        <service android:name=".RescueService" android:exported="false" />
    </application>
</manifest>
