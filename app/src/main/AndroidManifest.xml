<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- List of all processes and open apps (#69, #71), granted to the platform signature -->
    <uses-permission android:name="android.permission.REAL_GET_TASKS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.DUMP" tools:ignore="ProtectedPermissions" />
    <!-- Copy of the system UI to the USB stick (#62): writing to removable storage, granted to the platform signature -->
    <uses-permission android:name="android.permission.WRITE_MEDIA_STORAGE" tools:ignore="ProtectedPermissions" />
    <!-- Eject the USB stick from the log window (#106): unmounting a volume, granted to the platform signature -->
    <uses-permission android:name="android.permission.MOUNT_UNMOUNT_FILESYSTEMS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Granted automatically to the system uid (car version) -->
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />
    <uses-permission android:name="android.permission.SET_PREFERRED_APPLICATIONS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.DELETE_PACKAGES" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Sound page: spectrum of the current music (Visualizer on the audio output) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Day / night fade: image of the old screen kept on top during the rebuild -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- App embedded in the map: forced immersive mode (policy_control) -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Talk with MG4Dash Web, the Web app card's page (keyboard, card shown or hidden, #98) -->
    <uses-permission android:name="app.mg4dash.web.permission.TALK" />

    <application
        android:name=".LauncherApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_app"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.MG4Launcher"
        android:usesCleartextTraffic="true">

        <uses-library android:name="android.car" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".pages.ClimateActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.MG4Launcher" />

        <activity
            android:name=".pages.VehicleActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.MG4Launcher" />

        <!-- Car start: animation instead of "Phone is starting" (before unlocking) -->
        <activity
            android:name=".ui.BootSplashActivity"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <intent-filter android:priority="-1">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".pages.TripsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.MG4Launcher" />
        <activity
            android:name=".pages.SoundActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.MG4Launcher" />

        <activity
            android:name=".pages.PhoneActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.MG4Launcher" />

        <activity
            android:name=".pages.EnergyActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.MG4Launcher" />

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.MG4Launcher" />

        <activity
            android:name=".apps.AppsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.MG4Launcher" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Update from GitHub: installation result and home relaunch -->
        <!-- Keep climate on: screen readable from outside -->
        <activity android:name=".climate.ClimateHoldActivity" android:exported="false" android:screenOrientation="landscape"
            android:theme="@style/Theme.MG4Launcher" android:excludeFromRecents="true" android:launchMode="singleTask" />
        <activity android:name=".ui.ScreenOffActivity" android:exported="false"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" android:excludeFromRecents="true" />
        <receiver android:name=".system.Updater$Result" android:exported="false" />
        <receiver android:name=".system.RadioDashUpdater$Result" android:exported="false" />
        <receiver android:name=".system.AirlinkUpdater$Result" android:exported="false" />
        <receiver android:name=".system.Rescue$Result" android:exported="false" />
        <receiver android:name=".system.FogOverlay$Result" android:exported="false" />
        <receiver
            android:name=".system.Updater$Relaunch"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
