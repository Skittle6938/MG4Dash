<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MG4Launcher" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_root</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:statusBarColor">?attr/mgBgTop</item>
        <item name="android:navigationBarColor">?attr/mgBgTop</item>
        <item name="android:windowAnimationStyle">@null</item>
        <!-- Fenêtres de dialogue aux couleurs du thème MG4Dash en cours (et non au style de la voiture) -->
        <item name="android:alertDialogTheme">@style/MG4Dialog</item>
        <item name="alertDialogTheme">@style/MG4Dialog</item>
        <item name="colorAccent">?attr/mgAction</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/mgTextValue</item>
        <item name="mgBgTop">#FF0B0F17</item>
        <item name="mgBgBottom">#FF141B29</item>
        <item name="mgBgEnd">#FF0E1420</item>
        <item name="mgPanel">#D912161F</item>
        <item name="mgPanelBorder">#FF2A3142</item>
        <item name="mgButtonIdle">#FF1C2231</item>
        <item name="mgButtonPressed">#FF283048</item>
        <item name="mgGaugeOff">#FF262D3D</item>
        <item name="mgPill">#CC12161F</item>
        <item name="mgButtonDisabled">#801C2231</item>
        <item name="mgTextValue">#FFFFFFFF</item>
        <item name="mgTextTitle">#FF8A94A6</item>
        <item name="mgTextSub">#FFA0AEC0</item>
        <item name="mgTextDisabled">#FF4A5366</item>
        <item name="mgAction">#FF2979FF</item>
        <item name="mgSelect">#FF00D2FF</item>
        <item name="mgActionPressed">#FF1C54B2</item>
        <item name="mgActionDeep">#FF123672</item>
        <item name="mgActionDeeper">#FF0D2651</item>
        <item name="mgActionBorder">#FF4F91FF</item>
        <item name="mgActionTint">#262979FF</item>
        <item name="mgSelectTint">#2600D2FF</item>
    </style>

    <style name="MG4Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorBackground">?attr/mgBgBottom</item>
        <item name="android:textColorPrimary">?attr/mgTextValue</item>
        <item name="android:textColorSecondary">?attr/mgTextSub</item>
        <item name="android:textColor">?attr/mgTextValue</item>
        <item name="android:textColorAlertDialogListItem">?attr/mgTextValue</item>
        <item name="android:textColorHint">?attr/mgTextTitle</item>
        <item name="android:colorAccent">?attr/mgSelect</item>
        <item name="android:colorControlNormal">?attr/mgTextSub</item>
        <item name="android:colorControlActivated">?attr/mgSelect</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:buttonBarButtonStyle">@style/MG4DialogButton</item>
        <item name="android:windowTitleStyle">@style/MG4DialogTitle</item>
    </style>

    <style name="MG4DialogButton" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:textColor">?attr/mgSelect</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <style name="MG4DialogTitle" parent="android:TextAppearance.Material.DialogWindowTitle">
        <item name="android:textColor">?attr/mgTextValue</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="CardTitle">
        <item name="android:textColor">?attr/mgTextTitle</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="ValueBig">
        <item name="android:textColor">?attr/mgTextValue</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Sub">
        <item name="android:textColor">?attr/mgTextSub</item>
        <item name="android:textSize">18sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Panel">
        <item name="android:background">@drawable/bg_panel</item>
        <item name="android:padding">@dimen/panel_pad</item>
        <item name="android:elevation">6dp</item>
    </style>

    <style name="RoundButton">
        <item name="android:layout_width">@dimen/touch_min</item>
        <item name="android:layout_height">@dimen/touch_min</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:padding">14dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">?attr/mgTextValue</item>
    </style>

    <style name="Chip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/touch_min</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
