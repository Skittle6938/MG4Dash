    <string name="tu_welcome_t">Welcome to MG4Dash</string>
    <string name="tu_welcome_1">A quick tour of the main gestures, in a few steps.</string>
    <string name="tu_home_t">MG4Dash as the car\'s home screen</string>
    <string name="tu_home_path">Settings (gear) › System</string>
    <string name="tu_home_1">Replace SAIC home: MG4Dash opens at startup and with the Home button. Nothing is uninstalled: the original home screen is only switched off as the home screen</string>
    <string name="tu_home_2">Back to the original at any time (dealer visit, a problem): Maintenance mode, in the same place, one tap</string>
    <string name="tu_layouts_t">Three home layouts</string>
    <string name="tu_layouts_1">Choose it in Settings › Home: Full, Simple (large panels) or Map (large map)</string>
    <string name="tu_layouts_2">Also there: side bar or bottom bar; in Look: light, dark or automatic, colours</string>
    <string name="tu_bar_t">Side bar</string>
    <string name="tu_bar_1">Settings: tap = MG4Dash settings, long press = car settings, double tap = Wi-Fi</string>
    <string name="tu_bar_2">Energy: double tap = screen off, long press = switch the car off (never while driving)</string>
    <string name="tu_bar_3">Vehicle: double tap = lock / unlock the doors, long press = ESC off / on</string>
    <string name="tu_bar_4">Home: long press = all apps</string>
    <string name="tu_bar_5">Android Auto: long press = choose the app (Android Auto, CarPlay or another), double tap = cut / restore the phone connection</string>
    <string name="tu_climate_t">Climate</string>
    <string name="tu_climate_1">Long press A/C: intermittent A/C (tap A/C to stop it)</string>
    <string name="tu_climate_2">Long press the temperature: calibration; long press power: keep the climate on after leaving the car (camping)</string>
    <string name="tu_climate_3">Fan minus at the lowest speed turns the climate off</string>
    <string name="tu_energy_t">Energy</string>
    <string name="tu_energy_1">Tap a KERS segment: regeneration level; long press: one-pedal driving</string>
    <string name="tu_energy_2">CHARGE button: charging and V2L</string>
    <string name="tu_map_t">Map</string>
    <string name="tu_map_1">Button at the top right: map → consumption → shortcuts</string>
    <string name="tu_map_2">Long press the map: show another app in the map card</string>
    <string name="tu_media_t">Music</string>
    <string name="tu_media_1">Swipe up / down: next source; left / right: previous / next track</string>
    <string name="tu_media_2">Tap the source name: source menu; tap the picture: open the source\'s app</string>
    <string name="tu_media_3">Long press play / pause: Sound page</string>
    <string name="tu_widget_t">Bottom-right widget</string>
    <string name="tu_widget_1">Tap or swipe: next page (energy, power, phone)</string>
    <string name="tu_widget_2">Long press a phone shortcut: change it, or choose 2 to 8 shortcuts</string>
    <string name="tu_end_t">That\'s it!</string>
    <string name="tu_end_1">You can see this tour again in Settings › System.</string>
