<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog window background: opaque panel in the current MG4Dash theme colours -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="16dp">
    <shape android:shape="rectangle">
        <solid android:color="?attr/mgBgBottom" />
        <corners android:radius="@dimen/radius_panel" />
        <stroke android:width="1dp" android:color="?attr/mgPanelBorder" />
    </shape>
</inset>
