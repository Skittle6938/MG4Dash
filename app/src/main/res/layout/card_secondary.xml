<?xml version="1.0" encoding="utf-8"?>
<!-- Trip energy, power or phone card of the home screen (#97): one each, placed by MainActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/secondaryCard"
    style="@style/Panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_aa_tile_idle"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/secondaryTitle"
            style="@style/CardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sw_energy" />

        <TextView
            android:id="@+id/secondaryDots"
            style="@style/Sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.3"
            android:textSize="17sp"
            tools:text="● ○ ○" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/secondaryGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal" />
</LinearLayout>
